# Copy to .env.local and fill in. Add the same four to Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# console.anthropic.com → API Keys (server only, never exposed to the browser)
ANTHROPIC_API_KEY=

# The only email allowed to sign in
ALLOWED_EMAIL=

# ---- Local CLI only (NOT needed in Vercel) ----
# Supabase → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=
# The database password you set when creating the project
SUPABASE_DB_PASSWORD=
# The project ref (the subdomain of the project URL)
SUPABASE_PROJECT_REF=
